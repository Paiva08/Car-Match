{
  "name": "Car",
  "type": "object",
  "properties": {
    "marca": {
      "type": "string",
      "description": "Marca do ve\u00edculo"
    },
    "modelo": {
      "type": "string",
      "description": "Modelo do ve\u00edculo"
    },
    "foto_url": {
      "type": "string",
      "description": "URL da foto do ve\u00edculo"
    },
    "tipo_combustivel": {
      "type": "string",
      "enum": [
        "Gasolina",
        "Etanol",
        "Diesel",
        "Eletricidade",
        "H\u00edbrido",
        "Flex"
      ],
      "description": "Tipo de combust\u00edvel"
    },
    "tipo_veiculo": {
      "type": "string",
      "enum": [
        "Hatch",
        "Sedan",
        "SUV",
        "Pickup",
        "Compacto"
      ],
      "description": "Tipo de carroceria do ve\u00edculo"
    },
    "motorizacao": {
      "type": "string",
      "enum": [
        "1.0",
        "1.3",
        "1.4",
        "1.5",
        "1.6",
        "1.8",
        "2.0",
        "2.5",
        "3.0",
        "Turbo",
        "El\u00e9trico"
      ],
      "description": "Motoriza\u00e7\u00e3o do ve\u00edculo"
    },
    "transmissao": {
      "type": "string",
      "enum": [
        "Manual",
        "Autom\u00e1tico",
        "CVT",
        "Automatizado"
      ],
      "description": "Tipo de transmiss\u00e3o"
    },
    "autonomia": {
      "type": "number",
      "description": "Autonomia em km (para el\u00e9tricos \u00e9 a autonomia da bateria, para combust\u00e3o \u00e9 com tanque cheio)"
    },
    "ano": {
      "type": "number",
      "description": "Ano do ve\u00edculo"
    },
    "consumo_cidade": {
      "type": "number",
      "description": "Consumo na cidade em km/l ou km/kWh"
    },
    "consumo_estrada": {
      "type": "number",
      "description": "Consumo na estrada em km/l ou km/kWh"
    },
    "manutencao": {
      "type": "number",
      "description": "Custo de manuten\u00e7\u00e3o a cada 10000 km"
    },
    "co2": {
      "type": "number",
      "description": "Emiss\u00e3o de CO2 em g/km"
    },
    "valor_carro": {
      "type": "number",
      "description": "Valor do carro (Tabela FIPE)"
    },
    "valor_aluguel": {
      "type": "number",
      "description": "Valor mensal do aluguel"
    }
  },
  "required": [
    "marca",
    "modelo",
    "tipo_combustivel",
    "tipo_veiculo",
    "ano",
    "consumo_cidade",
    "consumo_estrada",
    "manutencao",
    "co2",
    "valor_carro",
    "valor_aluguel"
  ]
}